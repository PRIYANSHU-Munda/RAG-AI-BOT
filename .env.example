SECRET_KEY=change-me-to-a-long-random-string
DATA_DIR=data
SEED_DIR=seed_data
SEED=42
# Backends: defaults run fully offline with zero dependencies beyond requirements.txt
EMBED_BACKEND=hash            # hash | st
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_BACKEND=lexical        # lexical | st
RERANK_MODEL=BAAI/bge-reranker-base
NLI_BACKEND=lexical           # lexical | hf
NLI_MODEL=cross-encoder/nli-deberta-v3-small
LLM_BACKEND=extractive        # extractive | ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
PARSER_BACKEND=auto           # auto | docling | pypdf
